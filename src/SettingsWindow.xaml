<!-- MiniStats settings window. Loaded at runtime with XamlReader; wiring lives in SettingsWindow.cs. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniStats Settings" Width="980" Height="700" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#121218" Foreground="#ECECF1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" GlassFrameThickness="0,0,0,1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#1B1B25"/>
    <SolidColorBrush x:Key="Line" Color="#282836"/>
    <SolidColorBrush x:Key="Field" Color="#242432"/>
    <SolidColorBrush x:Key="FieldLine" Color="#33334A"/>
    <SolidColorBrush x:Key="Text" Color="#ECECF1"/>
    <SolidColorBrush x:Key="Sub" Color="#9A9AB2"/>
    <SolidColorBrush x:Key="Accent" Color="#7C8CFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#0D0E1A"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- text -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
    </Style>

    <!-- cards -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- sidebar navigation -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" CornerRadius="8" Background="Transparent" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ico" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border x:Name="pill" Width="3" Height="18" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1E1E2A"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#232332"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ico" Property="Foreground" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldLine}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A2A3A"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.25"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Sub}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="10,8" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#232332"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource FieldLine}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Swatch" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="White"/><Setter TargetName="b" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="42" Height="22" CornerRadius="11" Background="#2A2A38" BorderBrush="#4A4A60" BorderThickness="1">
              <Ellipse x:Name="knob" Width="14" Height="14" Fill="#B9B9CC" HorizontalAlignment="Left" Margin="4,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Fill" Value="{StaticResource AccentText}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="track" Property="Opacity" Value="0.9"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slider -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{StaticResource Accent}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="#34344A"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Fill="#ECECF1"/>
                          <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}"/>
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- combo box -->
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource FieldLine}" BorderThickness="1" CornerRadius="8">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#1E1E2A" BorderBrush="{StaticResource FieldLine}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" CornerRadius="6" Padding="10,7" Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2A3C"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#30305A"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- text box -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldLine}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- slim scroll bar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#3A3A50" Margin="1,0"/></ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- theme tile & corner spots -->
    <Style x:Key="Tile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource Line}" Padding="3">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#4A4A64"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Corner" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="corner"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Width="58" Height="16" CornerRadius="5" Background="#38FFFFFF"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#80FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#FFDE66"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="#121218">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <!-- ============================== sidebar -->
      <Border Background="#16161E" BorderBrush="#20202C" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,18,16,18">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,30">
            <Image x:Name="Logo" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="MiniStats" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="VersionText" Text="v1.1.0" FontSize="11.5" Foreground="{StaticResource Sub}"/>
            </StackPanel>
          </StackPanel>
          <Border x:Name="FpsPill" DockPanel.Dock="Bottom" CornerRadius="10" Background="#18261F" Padding="14,11">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="FpsDot" Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center"/>
              <TextBlock x:Name="FpsPillText" Text="FPS counter active" Margin="10,0,0,0" FontSize="12"/>
            </StackPanel>
          </Border>
          <StackPanel>
            <RadioButton x:Name="Nav0" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE9D9;" Content="Metrics" IsChecked="True"/>
            <RadioButton x:Name="Nav1" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE790;" Content="Appearance"/>
            <RadioButton x:Name="Nav2" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE707;" Content="Position"/>
            <RadioButton x:Name="Nav3" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE713;" Content="General"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ============================== main -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Button x:Name="MinBtn" Style="{StaticResource Caption}" Tag="#2A2A3A" Content="&#xE921;" ToolTip="Minimize"/>
          <Button x:Name="CloseBtn" Style="{StaticResource Caption}" Tag="#C42B1C" Content="&#xE8BB;" ToolTip="Close"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="36,0,36,18">
          <TextBlock x:Name="PageTitle" Text="Metrics" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
          <TextBlock x:Name="PageSub" Text="" Foreground="{StaticResource Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="36,0,36,18" CornerRadius="14" Height="96" BorderBrush="#2E2A4A" BorderThickness="1">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#101329" Offset="0"/>
              <GradientStop Color="#1C1640" Offset="0.55"/>
              <GradientStop Color="#2C1242" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <StackPanel Orientation="Horizontal" Margin="18,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Ellipse Width="6" Height="6" Fill="#3DDC84" VerticalAlignment="Center"/>
              <TextBlock Text="LIVE PREVIEW" FontSize="10.5" FontWeight="Bold" Foreground="#A9ADD6" Margin="8,0,0,0"/>
            </StackPanel>
            <Image x:Name="PreviewImage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="PreviewEmpty" Text="Nothing selected - turn on at least one metric." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C9CCE6"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,0,26,0" Focusable="False">
          <Grid Margin="0,0,10,8">

            <!-- ============ Metrics -->
            <StackPanel x:Name="Page0">
              <Border Style="{StaticResource Card}" Padding="10,6">
                <StackPanel x:Name="MetricRows"/>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Refresh rate" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="How often the numbers update. FPS is averaged over this time." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Slider x:Name="IntervalSlider" Grid.Column="1" Minimum="250" Maximum="3000" TickFrequency="250" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBlock x:Name="IntervalText" Grid.Column="2" Style="{StaticResource Value}"/>
                </Grid>
              </Border>
              <TextBlock x:Name="GpuNote" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="4,0,0,0"
                         Text="GPU usage, VRAM and temperature need an NVIDIA graphics card, so they show -- on this PC."/>
            </StackPanel>

            <!-- ============ Appearance -->
            <StackPanel x:Name="Page1" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Padding="20,16,8,4">
                <StackPanel>
                  <TextBlock Text="Theme" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Start from a preset, then fine-tune any colour below." Style="{StaticResource Hint}"/>
                  <WrapPanel x:Name="ThemeTiles" Margin="0,14,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Font" Style="{StaticResource CardTitle}"/>
                      <TextBlock Text="Any font installed on this PC." Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <ComboBox x:Name="FontCombo" Grid.Column="1"/>
                  </Grid>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Text size" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="7" Maximum="20" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="16,0,0,0"/>
                    <TextBlock x:Name="FontSizeText" Grid.Column="2" Style="{StaticResource Value}"/>
                  </Grid>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="16,0,0,0"/>
                    <TextBlock x:Name="OpacityText" Grid.Column="2" Style="{StaticResource Value}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Corner radius" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                    <Slider x:Name="RadiusSlider" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="16,0,0,0"/>
                    <TextBlock x:Name="RadiusText" Grid.Column="2" Style="{StaticResource Value}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="20,16,20,10">
                <StackPanel>
                  <TextBlock Text="Colours" Style="{StaticResource CardTitle}"/>
                  <TextBlock Text="Click a colour to change it." Style="{StaticResource Hint}"/>
                  <UniformGrid x:Name="ColorChips" Columns="4" Margin="-10,10,-10,0"/>
                </StackPanel>
              </Border>
              <Popup x:Name="ColorPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#1E1E2A" BorderBrush="{StaticResource FieldLine}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">
                  <StackPanel Width="240">
                    <TextBlock x:Name="ColorPopupTitle" Text="Colour" FontWeight="SemiBold" Margin="3,0,0,8"/>
                    <WrapPanel x:Name="Palette"/>
                    <DockPanel Margin="3,10,3,0">
                      <Button x:Name="SystemPickerBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="12,6" Content="More..." Margin="8,0,0,0"/>
                      <TextBox x:Name="HexBox" FontFamily="Cascadia Mono, Consolas" ToolTip="Type a hex colour and press Enter"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </Popup>
            </StackPanel>

            <!-- ============ Position -->
            <StackPanel x:Name="Page2" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Display" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Which screen the bar lives on." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <ComboBox x:Name="MonitorCombo" Grid.Column="1"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border x:Name="ScreenMock" Width="300" Height="140" CornerRadius="10" BorderBrush="#4A4A64" BorderThickness="1.5" VerticalAlignment="Top">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#26335E" Offset="0"/>
                        <GradientStop Color="#45265E" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                      <Border Height="12" VerticalAlignment="Bottom" Background="#A00A0C16" CornerRadius="0,0,8,8"/>
                      <RadioButton x:Name="CornerTL" Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" ToolTip="Top left"/>
                      <RadioButton x:Name="CornerTR" Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" ToolTip="Top right"/>
                      <RadioButton x:Name="CornerBL" Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,24" ToolTip="Bottom left"/>
                      <RadioButton x:Name="CornerBR" Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,24" ToolTip="Bottom right"/>
                      <Border x:Name="CustomBadge" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFDE66" CornerRadius="8" Padding="10,4">
                        <TextBlock Text="Custom spot" Foreground="#0D0E1A" FontWeight="SemiBold" FontSize="12"/>
                      </Border>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Placement" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Click a corner on the screen to dock the bar there, or drag it to any spot you like." Style="{StaticResource Hint}"/>
                    <Button x:Name="DragBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,16,0,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DragIcon" Text="&#xE7C2;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DragText" Text="Drag to place"/>
                      </StackPanel>
                    </Button>
                    <TextBlock x:Name="DragHint" Style="{StaticResource Hint}" Margin="0,10,0,0" Text="The bar unlocks so you can move it with the mouse. Click again to lock it."/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Edge distance" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="Gap between the bar and the screen edge when docked to a corner." Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Slider x:Name="MarginSlider" Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <TextBlock x:Name="MarginText" Grid.Column="2" Style="{StaticResource Value}"/>
                </Grid>
              </Border>
              <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,0" Text="Tip: double-click the tray icon, or run MiniStats.exe again, to open these settings any time."/>
            </StackPanel>

            <!-- ============ General -->
            <StackPanel x:Name="Page3" Visibility="Collapsed">
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="FPS counter" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                      <Border x:Name="FpsBadge" CornerRadius="9" Padding="9,2" Margin="10,0,0,0" Background="#1C3A2A" VerticalAlignment="Center">
                        <TextBlock x:Name="FpsBadgeText" Text="Active" FontSize="11" FontWeight="SemiBold" Foreground="#3DDC84"/>
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="FpsHint" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Button x:Name="ElevateBtn" Grid.Column="1" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Restart as administrator"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings file" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="OpenFileBtn" Style="{StaticResource Btn}" Content="Open" Margin="0,0,8,0"/>
                    <Button x:Name="ShowFolderBtn" Style="{StaticResource Btn}" Content="Show in folder"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource Card}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="About" Style="{StaticResource CardTitle}"/>
                    <TextBlock x:Name="AboutText" Style="{StaticResource Hint}"/>
                  </StackPanel>
                  <Button x:Name="GithubBtn" Grid.Column="1" Style="{StaticResource Btn}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="View on GitHub"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ============================== footer -->
        <Border Grid.Row="4" BorderBrush="#20202C" BorderThickness="0,1,0,0" Padding="36,14">
          <DockPanel>
            <Button x:Name="ResetBtn" DockPanel.Dock="Left" Style="{StaticResource Ghost}" Padding="10,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Reset to defaults"/>
              </StackPanel>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="Cancel" MinWidth="96" Margin="0,0,8,0"/>
              <Button x:Name="ApplyBtn" Style="{StaticResource Btn}" Content="Apply" MinWidth="96" Margin="0,0,8,0"/>
              <Button x:Name="SaveBtn" Style="{StaticResource Primary}" Content="Save" MinWidth="112"/>
            </StackPanel>
            <StackPanel x:Name="DirtyHint" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Hidden">
              <Ellipse Width="7" Height="7" Fill="#FFDE66" VerticalAlignment="Center"/>
              <TextBlock Text="Unsaved changes" Foreground="{StaticResource Sub}" Margin="8,0,0,0" FontSize="12"/>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
